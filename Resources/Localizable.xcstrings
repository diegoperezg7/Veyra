    },
    "wellnessAgeDetail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An estimate from your fitness and daily signals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación a partir de tu forma física y tus señales diarias."
          }
        }
      }
    },
    "wellnessAgeHistory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it has changed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo ha evolucionado"
          }
        }
      }
    },
    "wellnessAgeMethod": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a clinical biological age. The published methods (Klemera–Doubal, PhenoAge) require blood chemistry and a watch measures none of their markers. Veyra anchors the estimate on your VO₂max against age- and sex-normative curves, then applies bounded corrections for resting heart rate, training, HRV, sleep, regularity, steps, stress and body composition. The correction is scaled by the confidence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no es una edad biológica clínica. Los métodos publicados (Klemera–Doubal, PhenoAge) necesitan analítica de sangre y un reloj no mide ninguno de sus marcadores. Veyra ancla la estimación en tu VO₂máx frente a las curvas normativas por edad y sexo, y encima aplica correcciones acotadas por frecuencia en reposo, entrenamiento, VFC, sueño, regularidad, pasos, estrés y composición corporal. La corrección se escala por la confianza."
          }
        }
      }
    },
    "wellnessAgeNeedsBirthDate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your date of birth in Profile to generate an estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica tu fecha de nacimiento en Perfil para generar una estimación."
          }
        }
      }
    },
    "wellnessAgeNeedsSignal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one real signal is needed: sleep, steps, resting heart rate, VO2 or BMI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace falta al menos una señal real: sueño, pasos, frecuencia en reposo, VO2 o IMC."
          }
        }
      }
    },
    "wellnessAgeOlder": {
