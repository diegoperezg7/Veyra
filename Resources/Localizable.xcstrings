    "watchAlarmDetail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Veyra on Watch to confirm scheduling. It evaluates motion inside the window; it does not know live sleep stages. Execution depends on watchOS and an operational watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Veyra en el Watch para confirmar la programación. El reloj evalúa movimiento dentro de la ventana; no conoce las fases del sueño en tiempo real. La ejecución depende de watchOS y de que el reloj esté operativo."
          }
        }
      }
    },
