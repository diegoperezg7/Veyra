    "stressCalibrationDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Veyra uses three heart-rate observations for a provisional estimate and seven days for normal calibration. Exercise intervals are excluded from resting stress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Veyra usa tres observaciones de frecuencia cardíaca para una estimación provisional y siete días para la calibración normal. Los intervalos de ejercicio se excluyen del estrés en reposo."
          }
        }
      }
    },
    "stressExplanation": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures where your heart rate sits between your resting and maximum rates, adjusted for variability and for movement that would explain a raised pulse. Workouts are excluded: that is effort, not activation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide dónde está tu frecuencia cardíaca entre tu reposo y tu máximo, corregido por la variabilidad y por el movimiento que explique una pulsación alta. Los entrenamientos quedan fuera: eso es esfuerzo, no activación."
          }
        }
      }
    },
    "stressLevel": {
      "extractionState": "manual",
      "localizations": {
