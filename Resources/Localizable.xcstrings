    },
    "wellnessFormula": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heuristic: entered age minus (average sleep−75)/25, minus (average steps−6000)/4000 bounded ±2. Requires 14 valid days. Changes do not represent years of life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Heurística: edad indicada menos (sueño medio−75)/25, menos (pasos medios−6000)/4000 limitado a ±2. Requiere 14 días válidos. Los cambios no equivalen a años de vida."
          }
        }
      }
    },
