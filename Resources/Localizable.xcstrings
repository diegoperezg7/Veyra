    "batteryMethod": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental estimate from 0 to 100. Starts from sleep and recovery, decreases with waking time, stress and exercise, and increases with naps or observed rest. Changes are the net balance of each 15-minute interval. It does not measure physical reserves or reproduce private algorithms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación experimental de 0 a 100. Parte del sueño y la recuperación; baja con el tiempo despierto, el estrés y el ejercicio, y sube con las siestas o el descanso observado. Los cambios mostrados son el balance neto de cada intervalo de 15 minutos. No mide reservas físicas ni reproduce algoritmos privados."
          }
        }
      }
    },
