    "weighInReminderDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weighing at the same time each day, fasted and after the bathroom, is what makes the series comparable day to day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesarse siempre a la misma hora, en ayunas y después del baño, es lo que hace comparable la serie de un día a otro."
          }
        }
      }
    },
