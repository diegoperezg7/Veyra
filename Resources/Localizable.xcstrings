          "stringUnit": {
            "state": "translated",
            "value": "You can edit both here. If Health has them, Veyra fills them in the first time and then respects whatever you change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes editar ambos aquí. Si Salud los tiene, Veyra los rellena la primera vez y respeta después lo que tú cambies."
          }
        }
      }
    },
    "profileFromHealthDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulls date of birth and biological sex from Health, overwriting what is here. Apple does not expose the user's name to apps, so Veyra cannot read it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae la fecha de nacimiento y el sexo biológico desde Salud, sobrescribiendo lo que haya aquí. Apple no expone el nombre del usuario a las apps, así que Veyra no puede leerlo."
          }
        }
      }
    },
