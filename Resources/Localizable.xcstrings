    "probeDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the last 7 days of every type and shows how many samples Health returns. A 0 for heart rate or steps means that permission is off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee los últimos 7 días de cada tipo y muestra cuántas muestras devuelve Salud. Un 0 en frecuencia cardíaca o pasos indica que ese permiso está desactivado."
          }
        }
      }
    },
