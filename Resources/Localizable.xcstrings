    "recalibrateDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wellness age summarises weeks of data, so it is recalculated once a week. Recomputing it continuously would make it wobble without meaning anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edad de bienestar resume semanas de datos, así que se recalcula una vez por semana. Recalcularla de continuo la haría oscilar sin que significara nada."
          }
        }
      }
    },
