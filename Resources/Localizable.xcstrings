    "fitnessAgeDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your VO₂max matches the median for someone of this age. It is the anchor of the estimate and its best-founded part."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu VO₂máx equivale a la mediana de alguien de esta edad. Es el ancla de la estimación y la parte mejor fundamentada."
          }
        }
      }
    },
    "fitnessAgeSaturated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your VO₂max is above what the reference curve can express, so the scale stops here. That is a limit of the reference, not of you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu VO₂máx está por encima de lo que la curva de referencia puede expresar, así que la escala se detiene aquí. Es un tope de la referencia, no un límite tuyo."
          }
        }
      }
    },
