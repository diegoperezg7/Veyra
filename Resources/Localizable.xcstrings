    "welcomeDetail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep, recovery, training and nutrition. A view of your day grounded in your own data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sueño, recuperación, entrenamiento y nutrición. Una visión de tu día que parte de tus propios datos."
          }
        }
      }
    },
