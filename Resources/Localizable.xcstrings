      }
    },
    "batteryBandsDetailEstimated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shaded bands mark when you were asleep and when you were training; the line is your level at that moment. Where no stress measurement exists the level is estimated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las franjas de color marcan cuándo dormías y cuándo entrenabas; la línea es tu nivel en ese momento. En los tramos sin medición de estrés el nivel se estima."
          }
        }
      }
    },
