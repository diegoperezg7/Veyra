    },
    "scalesSetup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Renpho: enable Apple Health in Renpho Health and allow reading weight and composition in Health → Sharing → Apps → Veyra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para Renpho: activa Apple Salud en Renpho Health y permite la lectura de peso y composición en Salud → Compartir → Apps → Veyra."
          }
        }
      }
    },
    "scalesUnsupportedFields": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health publishes no official type for muscle mass, body water or bone mass, so those stay in the scale's own app. Lean mass does come through and is the closest equivalent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Salud no publica masa muscular, agua corporal ni masa ósea como tipos oficiales, así que esos indicadores se quedan en la app de la báscula. La masa magra sí llega y es lo más cercano."
          }
        }
      }
    },
