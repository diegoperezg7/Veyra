    "referenceScalesDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are published population scales (WHO BMI, ACE body fat), not personal targets. BMI cannot tell muscle from fat, which is why it is shown next to body-fat percentage and never on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son escalas de población publicadas (IMC de la OMS, grasa corporal de ACE), no objetivos personales. El IMC no distingue músculo de grasa: por eso se muestra junto al porcentaje de grasa y no solo."
          }
        }
      }
    },
